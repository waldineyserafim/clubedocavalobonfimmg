rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helpers =====
    function isSignedIn() { return request.auth != null; }
    function isImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024     // máx. 5 MB
        && request.resource.contentType.matches('image/.*');
    }

    // Fase 3.4 — leitura cross-service de Firestore, pra saber a que
    // organização quem está enviando pertence (espelha userOrgId() de
    // firestore.rules). Antes desta fase, tenants/{orgId}/cms só checava
    // isSignedIn()+isImage() — qualquer usuário autenticado podia escrever
    // no caminho de QUALQUER organização, não só a própria.
    function callerOrgId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.orgId;
    }
    function isOwnOrg(orgId) {
      return isSignedIn() && callerOrgId() == orgId;
    }

    // Fase 3.6 (patch de segurança) — mesmo padrão de platformAdminActive()/
    // isPlatformAdministrator() de firestore.rules, do lado do Storage: lê
    // platformAdmins/{uid} cross-service pra saber se quem está enviando é
    // administrator/owner da plataforma (operator é só-leitura, não sobe
    // branding).
    function platformRole() {
      return firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.role;
    }
    function isPlatformAdministrator() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/platformAdmins/$(request.auth.uid)).data.ativo != false
        && platformRole() in ['administrator', 'owner'];
    }

    // ===== NOVO: caminho usado pelo seu frontend (uploads/*) =====
    // Ex.: uploads/products/..., uploads/services/..., uploads/classifieds/...
    // Fase 3.6 (patch de segurança): antes, qualquer usuário autenticado
    // podia sobrescrever/substituir a imagem de QUALQUER OUTRO usuário nesse
    // caminho (zero checagem de dono). Como o path não carrega uid nenhum
    // (ex.: uploads/products/{timestamp}_{nome}.jpg), a correção usa
    // metadata customizado gravado no próprio upload: `resource` (estado já
    // salvo) precisa bater com quem está gravando quando já existe algo
    // nesse caminho — `resource == null` é o caso de upload novo, sempre
    // permitido pra qualquer usuário logado, igual a hoje.
    match /uploads/{category}/{fileName} {
      allow read: if true; // leitura pública das imagens (ajuste se quiser)
      allow write: if isSignedIn() && isImage()
        && (category == 'products' || category == 'services' || category == 'classifieds')
        && (resource == null || resource.metadata.uid == request.auth.uid)
        && request.resource.metadata.uid == request.auth.uid;
    }

    // ===== Caminhos por-usuário que você já tinha =====
    // Classificados (leitura pública; gravação só do dono)
    match /classifieds/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // Produtos e Serviços por-usuário (opcional – mantém compatibilidade)
    match /products/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    match /services/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // ===== Carteirinha Digital — foto de perfil do associado =====
    // Mesmo padrão de products/services: leitura pública (a carteirinha e a
    // tela de verificação exibem a foto sem exigir login — mesmo princípio
    // de organizations/{orgId}/public/branding), escrita só do próprio uid.
    match /membershipCards/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // ===== Módulo de Leilões =====
    // Imagens de lotes: auctionLots/{uid}/{fileName}
    match /auctionLots/{uid}/{fileName} {
      allow read: if true;  // leitura pública (exibição nos cards)
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // ===== CMS (banners, destaques, etc.) — escrita restrita à PRÓPRIA organização =====
    match /tenants/{orgId}/cms/{category}/{fileName} {
      allow read: if true;
      allow write: if isOwnOrg(orgId) && isImage();
    }

    // ===== Identidade visual da organização (Fase 3.4) — logo/favicon =====
    // Leitura pública pelo mesmo motivo do CMS: logo/favicon precisam
    // aparecer no site público da organização.
    // Fase 3.6 (correção funcional): o único escritor real deste caminho é
    // a equipe de plataforma via Central de Configuração
    // (organization-detail.html) — que nunca tem users/{uid}.orgId, então
    // isOwnOrg() sozinho tornava este upload estruturalmente impossível de
    // funcionar. isPlatformAdministrator() cobre o caso real.
    match /tenants/{orgId}/branding/{fileName} {
      allow read: if true;
      allow write: if (isOwnOrg(orgId) || isPlatformAdministrator()) && isImage();
    }

    // ===== Bloqueia todo o resto =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
