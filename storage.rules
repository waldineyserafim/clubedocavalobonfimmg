rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helpers =====
    function isSignedIn() { return request.auth != null; }
    function isImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024     // máx. 5 MB
        && request.resource.contentType.matches('image/.*');
    }

    // Fase 3.4 — leitura cross-service de Firestore, pra saber a que
    // organização quem está enviando pertence (espelha userOrgId() de
    // firestore.rules). Antes desta fase, tenants/{orgId}/cms só checava
    // isSignedIn()+isImage() — qualquer usuário autenticado podia escrever
    // no caminho de QUALQUER organização, não só a própria.
    function callerOrgId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.orgId;
    }
    function isOwnOrg(orgId) {
      return isSignedIn() && callerOrgId() == orgId;
    }

    // ===== NOVO: caminho usado pelo seu frontend (uploads/*) =====
    // Ex.: uploads/products/..., uploads/services/..., uploads/classifieds/...
    match /uploads/{category}/{fileName} {
      allow read: if true; // leitura pública das imagens (ajuste se quiser)
      allow write: if isSignedIn() && isImage()
        && (category == 'products' || category == 'services' || category == 'classifieds');
      // write cobre create/update/delete
    }

    // ===== Caminhos por-usuário que você já tinha =====
    // Classificados (leitura pública; gravação só do dono)
    match /classifieds/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // Produtos e Serviços por-usuário (opcional – mantém compatibilidade)
    match /products/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    match /services/{uid}/{docId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // ===== Módulo de Leilões =====
    // Imagens de lotes: auctionLots/{uid}/{fileName}
    match /auctionLots/{uid}/{fileName} {
      allow read: if true;  // leitura pública (exibição nos cards)
      allow write: if isSignedIn() && request.auth.uid == uid && isImage();
    }

    // ===== CMS (banners, destaques, etc.) — escrita restrita à PRÓPRIA organização =====
    match /tenants/{orgId}/cms/{category}/{fileName} {
      allow read: if true;
      allow write: if isOwnOrg(orgId) && isImage();
    }

    // ===== Identidade visual da organização (Fase 3.4) — logo/favicon =====
    // Leitura pública pelo mesmo motivo do CMS: logo/favicon precisam
    // aparecer no site público da organização.
    match /tenants/{orgId}/branding/{fileName} {
      allow read: if true;
      allow write: if isOwnOrg(orgId) && isImage();
    }

    // ===== Bloqueia todo o resto =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
