// Firestore Security Rules (final, revisado)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helpers --------
    function isLoggedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // Lê o papel do usuário logado; se não existir doc, devolve string vazia
    function userRoleRaw() {
      return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
        : "";
    }

    // Lê o orgId do usuário logado
    function userOrgId() {
      return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    // Testes de papel (lower + trim para evitar problemas de capitalização/espaço)
    function roleLower() {
      return (userRoleRaw() is string) ? userRoleRaw().lower().trim() : "";
    }
    function isRole(roleName) { return roleLower() == roleName; }

    // >>> Fase 3.2: dois planos de identidade separados — Plataforma (nunca
    // tem organização) e Organização (nunca sai da própria). isMaster()/
    // isAdminRole() (cross-tenant cego, sem checagem de organização nenhuma)
    // NÃO EXISTEM MAIS — ver docs/CLAUDE.md "Fase 3.2" e o relatório da fase.

    // -------- Plataforma: platformAdmins/{uid}, nunca tem orgId --------
    function platformAdminActive() {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.ativo != false;
    }
    function platformRoleLower() {
      return platformAdminActive()
        ? get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role
        : "";
    }
    // Qualquer papel de plataforma ativo (operator, administrator ou owner).
    function isPlatformStaff() { return platformAdminActive(); }
    // administrator ou owner — nunca operator (Platform Operator é só leitura).
    function isPlatformAdministrator() {
      return platformAdminActive() && platformRoleLower() in ["administrator", "owner"];
    }
    function isPlatformOwner() {
      return platformAdminActive() && platformRoleLower() == "owner";
    }

    // -------- Organização: users/{uid}.role, sempre com orgId --------
    // "master" sobrevive só como rótulo do papel Organization Master (não é
    // mais um bypass cross-tenant — sempre comparado à organização, como
    // admin/adminView já eram). Ver Contexto do relatório da Fase 3.2.
    function isOrgMaster(orgId) { return isLoggedIn() && roleLower() == "master" && userOrgId() == orgId; }
    function isOrgAdmin(orgId)  { return isLoggedIn() && roleLower() == "admin"  && userOrgId() == orgId; }
    function isOrgViewer(orgId) { return isLoggedIn() && roleLower() == "admin view" && userOrgId() == orgId; }

    // >>> G3 (docs/SAAS_MULTITENANT.md): isolamento por organização.
    // Nunca checar só PAPEL (admin/master) sem organização — um admin de
    // qualquer org podia ler/escrever dados de qualquer outra org com só
    // isso. As variantes abaixo acrescentam a checagem de orgId.
    //
    // ESCRITA (create/update/delete): só quem pertence à organização — nunca
    // plataforma (Fase 3.2: bypass de escrita de isMaster() removido de
    // propósito; nenhuma tela viva hoje dependia disso além de
    // admin_associados.html, e mesmo essa só pra contas que já eram,
    // mecanicamente, restritas à própria organização — ver relatório).
    function canOperateOrg(orgId) {
      return isOrgMaster(orgId) || isOrgAdmin(orgId);
    }
    // LEITURA (get/list): mantém visibilidade de plataforma (suporte/
    // supervisão) e acrescenta Organization Viewer — lacuna real que existia
    // antes desta fase (isAdminRole() nunca incluía adminView em leitura
    // nenhuma; ver Contexto do relatório).
    function canReadOrg(orgId) {
      return isPlatformStaff() || isOrgMaster(orgId) || isOrgAdmin(orgId) || isOrgViewer(orgId);
    }

    // Para subcoleções de users/{userId} que não carregam orgId próprio
    // (finance/financeInvoices) — le o orgId do documento pai (o usuário
    // dono da subcoleção, não o admin logado).
    function canOperateOrgOfUser(userId) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        canOperateOrg(get(/databases/$(database)/documents/users/$(userId)).data.orgId);
    }
    function canReadOrgOfUser(userId) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        canReadOrg(get(/databases/$(database)/documents/users/$(userId)).data.orgId);
    }

    // Para cms_gallery/{albumId}/fotos/{fotoId} — os documentos de foto não
    // gravam orgId próprio, só o álbum pai grava. (Leitura de fotos já é
    // pública — allow read:true — só a escrita passa por aqui.)
    function canOperateOrgOfAlbum(albumId) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/cms_gallery/$(albumId)) &&
        canOperateOrg(get(/databases/$(database)/documents/cms_gallery/$(albumId)).data.orgId);
    }
    // <<< FIM G3

    // >>> Fase 2C: módulo de leilões passa a ter orgId (ver docs/FASE2C_*.md).
    // Para auctionLots/{lotId}/bids/{bidId} — lances não gravam orgId próprio,
    // herdam do lote pai (mesmo padrão de canOperateOrgOfAlbum acima).
    function sameOrgAsLot(lotId) {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/auctionLots/$(lotId)) &&
        get(/databases/$(database)/documents/auctionLots/$(lotId)).data.orgId == userOrgId();
    }
    // <<< Fase 2C

    // Associado ativo (pode criar lotes)
    function isAssociadoOrAdmin() {
      return isLoggedIn() && (
        isRole("associado") || isRole("admin") || isRole("master")
      );
    }

    // Impede que cliente comum altere campos sensíveis (aplicado em update de users)
    function noSensitiveFieldChange() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return !changed.hasAny([
        "role",
        "status",
        "inadimplenteLeilao",
        "ativo",
        "asaasId",
        "asaasSubscriptionId",
        "asaasSync",
        "orgId",
        "desativadoEm",
        "desativadoPor",
        "notaDesativacao",
        "categoriaAssociado",
        "responsavelCpf",
        "responsavelUid"
      ]);
    }

    // >>> ADIÇÃO: helpers para validação de criação de faturas pelo cliente
    function _hasOnlyKeys(allowedKeys) {
      // todos os campos novos precisam estar na lista de permitidos
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function _isInvoiceCreateValid() {
      // Permite criar SOMENTE estes campos
      let okKeys = _hasOnlyKeys([
        "planType",
        "planName",
        "planStart",
        "planEnd",
        "dueDate",
        "amount",
        "status",
        "months",
        "createdAt",
        "recordedAt"
      ]);

      // Tipos básicos
      let okTypes =
        (request.resource.data.amount is number) &&
        (request.resource.data.planType is string) &&
        (request.resource.data.planName is string);

      // Status inicial aceito
      let st = request.resource.data.status;
      let okStatus = (st is string) && (st.matches('(?i)^pendente$') || st.matches('(?i)^em_aberto$'));

      // Bloquear campos sensíveis na criação
      let noSensitive =
        !("paidAt" in request.resource.data) &&
        !("gatewayId" in request.resource.data) &&
        !("method" in request.resource.data) &&
        !("mp" in request.resource.data) &&
        !("updatedAt" in request.resource.data);

      return okKeys && okTypes && okStatus && noSensitive;
    }
    // <<< FIM ADIÇÃO

    // ===========================
    //   Catálogo: Serviços/Produtos
    // ===========================
    // Leitura exige sessão (isLoggedIn) — por isso dá para comparar orgId
    // aqui, diferente das coleções de CMS abaixo com leitura pública sem
    // sessão (ver docs/SAAS_MULTITENANT.md e a nota de reconciliação em
    // docs/architecture/README.md do Portal Associativo).
    match /memberServices/{docId} {
      allow read:   if isPlatformStaff() || (isLoggedIn() && resource.data.orgId == userOrgId());
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    match /memberProducts/{docId} {
      allow read:   if isPlatformStaff() || (isLoggedIn() && resource.data.orgId == userOrgId());
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // ===========================
    //   Legacy/Área do Associado: classificados internos
    // ===========================
    match /memberClassifieds/{docId} {
      // leitura pública (ajuste se quiser privatizar)
      allow read: if true;

      // CREATE: logado, dono informado por qualquer um dos campos aceitos, e
      // sempre na própria organização (Fase 2C — antes não checava orgId
      // nenhum; classificados.html já grava orgId:currentOrgId há tempo).
      allow create: if isLoggedIn() &&
                    (
                      ("createdBy" in request.resource.data && request.resource.data.createdBy == request.auth.uid)
                      ||
                      ("ownerUid"  in request.resource.data && request.resource.data.ownerUid  == request.auth.uid)
                    )
                    && request.resource.data.orgId == userOrgId();

      // UPDATE:
      // - admin/master da MESMA organização: tudo (Fase 2C — canOperate() sozinho
      //   deixava admin de qualquer org editar classificado de qualquer outra)
      // - dono: pode atualizar, mas NÃO pode mudar campos de propriedade/approvação/orgId
      allow update: if
        canOperateOrg(resource.data.orgId)
        ||
        (
          isLoggedIn() &&
          (
            resource.data.createdBy == request.auth.uid ||
            ("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid)
          ) &&
          !(
            "approved"  in request.resource.data.diff(resource.data).changedKeys() ||
            "createdBy" in request.resource.data.diff(resource.data).changedKeys() ||
            "ownerUid"  in request.resource.data.diff(resource.data).changedKeys() ||
            "orgId"     in request.resource.data.diff(resource.data).changedKeys()
          )
        );

      // DELETE: admin/master da MESMA organização, ou dono
      allow delete: if
        canOperateOrg(resource.data.orgId)
        ||
        (
          isLoggedIn() &&
          (
            resource.data.createdBy == request.auth.uid ||
            ("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid)
          )
        );
    }

    // ===========================
    //   Coleção pública 'classificados' — LEGADA/NÃO UTILIZADA
    //   (confirmado na Fase 2C: nenhuma página nem Cloud Function escreve
    //   aqui hoje — classificados.html grava em memberClassifieds; esta
    //   coleção só existe por compatibilidade com um nome antigo. Mantida
    //   sem exigir orgId no create — se algum documento antigo existir sem
    //   o campo, canOperateOrg() simplesmente não dá acesso admin cross-org
    //   a ele, e o dono continua podendo editar o próprio, sem regressão.)
    // ===========================
    match /classificados/{docId} {
      // leitura pública (qualquer visitante)
      allow get, list: if true;

      // CREATE: logado + createdBy==uid OU ownerUid==uid
      allow create: if isLoggedIn() &&
                    (
                      ("ownerUid"  in request.resource.data && request.resource.data.ownerUid  == request.auth.uid)
                      ||
                      ("createdBy" in request.resource.data && request.resource.data.createdBy == request.auth.uid)
                    );

      // UPDATE:
      // - admin/master da MESMA organização (Fase 2C): tudo
      // - dono: não pode mudar ownerUid/ownerEmail/createdBy
      allow update: if
        canOperateOrg(resource.data.orgId)
        ||
        (
          isLoggedIn() &&
          (
            ("ownerUid"  in resource.data && resource.data.ownerUid  == request.auth.uid) ||
            ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid)
          ) &&
          !(
            "ownerUid"   in request.resource.data.diff(resource.data).changedKeys() ||
            "ownerEmail" in request.resource.data.diff(resource.data).changedKeys() ||
            "createdBy"  in request.resource.data.diff(resource.data).changedKeys()
          )
        );

      // DELETE: admin/master da MESMA organização, ou dono
      allow delete: if
        canOperateOrg(resource.data.orgId)
        ||
        (
          isLoggedIn() &&
          (
            ("ownerUid"  in resource.data && resource.data.ownerUid  == request.auth.uid) ||
            ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid)
          )
        );
    }

    // ===========================
    //   Usuários + Financeiro
    // ===========================
    match /users/{userId} {

      // Leitura de 1 doc: dono, qualquer papel de plataforma, ou
      // master/admin/viewer da MESMA org (Fase 3.2: viewer ganha leitura de
      // verdade aqui — não tinha nenhuma antes).
      allow get: if isSelf(userId) || canReadOrg(resource.data.orgId);

      // Listagem (para grids/admin) — mesma regra de leitura acima
      // (Firestore avalia "list" por documento candidato quando a regra usa
      // resource.data — docs de outra org simplesmente não retornam, sem
      // depender de nenhum where() do lado do cliente).
      allow list: if canReadOrg(resource.data.orgId);

      // Criação:
      // - dono cria o próprio (signup) — PATCH CRÍTICO (Fase 3.6): antes,
      //   isSelf(userId) sozinho não validava nenhum campo do payload,
      //   permitindo um auto-cadastro gravar role:"master"/orgId arbitrário
      //   e assumir controle total de qualquer organização. Restrito ao
      //   mínimo necessário para não quebrar os dois fluxos de auto-cadastro
      //   reais (doSignupWithProfile/doSignupParticipanteLeilao, firebase.js)
      //   — que sempre gravam role fixo e orgId de uma organização real.
      // - master/admin da própria org criam (Fase 3.2: plataforma NÃO cria
      //   usuário de organização nenhuma diretamente — isso é escrita
      //   operacional, fora do escopo de plataforma)
      allow create: if (
        isSelf(userId)
        && request.resource.data.role in ["associado", "participanteLeilao"]
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId))
      ) || canOperateOrg(request.resource.data.orgId);

      // Atualização:
      // - dono: tudo exceto campos sensíveis (já bloqueia troca de orgId)
      // - master/admin da própria org: qualquer campo, exceto orgId (gap
      //   encontrado durante G3: canOperate() sozinho permitia trocar orgId
      //   no mesmo update que qualquer outro campo)
      // - campo "role": só master pode alterá-lo (Fase 3.2 — Organization
      //   Administrator não pode alterar papel de ninguém da equipe, evita
      //   escalonamento lateral; mais restritivo que antes, de propósito)
      allow update: if
        (isSelf(userId) && noSensitiveFieldChange())
        || (
          canOperateOrg(resource.data.orgId)
          && !("orgId" in request.resource.data.diff(resource.data).changedKeys())
          && (
            !("role" in request.resource.data.diff(resource.data).changedKeys())
            || isOrgMaster(resource.data.orgId)
          )
        );

      // -------- FINANCE (doc 'summary' e outros docs soltos) --------
      match /finance/{docId} {
        // dono, plataforma, master/admin/viewer da própria org podem LER — G3 + Fase 3.2
        allow read:  if isSelf(userId) || canReadOrgOfUser(userId);
        // só master/admin da própria org podem ESCREVER (summary, etc.) — G3
        allow write: if canOperateOrgOfUser(userId);

        // (Mantido por compatibilidade com estrutura antiga)
        match /invoices/{invId} {
          allow read:  if isSelf(userId) || canReadOrgOfUser(userId);
          allow write: if canOperateOrgOfUser(userId);
        }
      }

      // -------- NOVA COLEÇÃO DE FATURAS --------
      // Subcoleção direta para faturas: users/{uid}/financeInvoices/{invoiceId}
      match /financeInvoices/{invId} {
        // dono, plataforma, master/admin/viewer da própria org podem LER — G3 + Fase 3.2
        allow read:  if isSelf(userId) || canReadOrgOfUser(userId);

        // >>> ADIÇÃO: permitir o PRÓPRIO USUÁRIO criar a PRÓPRIA fatura
        allow create: if isSelf(userId) && _isInvoiceCreateValid();

        // só master/admin da própria org continuam podendo escrever
        // (editar/cancelar/pagar) — G3
        allow write: if canOperateOrgOfUser(userId);
      }
    }

    // ===========================
    //   Módulo de Leilões
    // ===========================

    match /auctionLots/{lotId} {
      // Leitura pública para lotes publicados/encerrados/concluídos (sem checagem de
      // organização de propósito — é a vitrine pública do leilão, mesmo padrão de
      // cms_* com allow read:true; leitura autenticada por dono/admin abaixo já é
      // escopada por organização).
      allow get:  if resource.data.status in ["publicado","encerrado","pago","concluido","cancelado"]
                  || isPlatformStaff()
                  || (isLoggedIn() && (
                       request.auth.uid == resource.data.sellerUid
                       || canOperateOrg(resource.data.orgId)
                     ));
      // Fase 2C: list agora exige mesma organização (antes, isAssociadoOrAdmin()
      // sozinho deixava qualquer associado logado listar lotes de qualquer org —
      // inofensivo hoje com 1 org só, mas o mesmo gap de G3, só que neste módulo).
      allow list: if
        isPlatformStaff()
        || canOperateOrg(resource.data.orgId)
        || (isAssociadoOrAdmin() && resource.data.orgId == userOrgId());

      // Criação: apenas associados (não participanteLeilao), sempre na própria organização
      allow create: if isAssociadoOrAdmin()
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.orgId == userOrgId()
                    && request.resource.data.status in ["rascunho","em_analise"];

      // Atualização: orgId nunca muda depois de criado (nenhum fluxo legítimo hoje
      // precisa "mover" um lote de organização); dono só edita dentro das mesmas
      // janelas de status de sempre.
      allow update: if
        !("orgId" in request.resource.data.diff(resource.data).changedKeys())
        && (
          canOperateOrg(resource.data.orgId)
          || (
            isLoggedIn()
            && request.auth.uid == resource.data.sellerUid
            && resource.data.status in ["rascunho","rejeitado"]
            && !(request.resource.data.diff(resource.data).changedKeys().hasAny(
                 ["approvedBy","approvedAt","lastBid","lastBidderUid","bidCount"]))
          )
          || (
            // Envio para análise: dono pode mudar status rascunho → em_analise
            isLoggedIn()
            && request.auth.uid == resource.data.sellerUid
            && resource.data.status == "rascunho"
            && request.resource.data.status == "em_analise"
            && !(request.resource.data.diff(resource.data).changedKeys().hasAny(
                 ["approvedBy","approvedAt","lastBid","lastBidderUid","bidCount"]))
          )
          || (
            // Cancelamento: dono pode cancelar lote em rascunho
            isLoggedIn()
            && request.auth.uid == resource.data.sellerUid
            && resource.data.status == "rascunho"
            && request.resource.data.status == "cancelado"
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status","updatedAt"])
          )
        );
    }

    match /auctionLots/{lotId}/bids/{bidId} {
      // Fase 2C: lances agora só são legíveis por usuários da MESMA organização do
      // lote (antes, isLoggedIn() sozinho expunha lance/valor/identidade do lance
      // para qualquer usuário autenticado de qualquer organização da plataforma).
      allow read: if sameOrgAsLot(lotId);
      // Escrita: SOMENTE via Cloud Function (Admin SDK ignora essas regras)
      allow write: if false;
    }

    match /auctionSales/{saleId} {
      allow read: if isPlatformStaff() || (isLoggedIn() && (
        request.auth.uid == resource.data.sellerUid
        || request.auth.uid == resource.data.buyerUid
        || canOperateOrg(resource.data.orgId)
      ));
      allow write: if false; // Apenas Cloud Functions
    }

    match /auctionPayments/{paymentId} {
      allow read: if isPlatformStaff() || (isLoggedIn() && (
        request.auth.uid == resource.data.buyerUid
        || canOperateOrg(resource.data.orgId)
      ));
      allow write: if false; // Apenas Cloud Functions
    }

    match /auctionNotifications/{notifId} {
      allow read: if isLoggedIn() && request.auth.uid == resource.data.recipientUid;
      // Permite marcar notificação como lida
      allow update: if isLoggedIn()
                    && request.auth.uid == resource.data.recipientUid
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"]);
      allow create, delete: if false; // Apenas Cloud Functions
    }

    // ===========================
    //   Multi-Tenant: Organizations & System
    // ===========================

    // Fase 3.2: equipe da plataforma (Serafim Technologies) — nunca tem
    // orgId, escrita só via Cloud Functions (Admin SDK), nunca direto do
    // cliente, pra garantir que toda mutação de equipe de plataforma seja
    // auditada no servidor por construção (ver functions/lib/platform.js).
    match /platformAdmins/{uid} {
      allow get: if isSelf(uid) || isPlatformStaff();
      allow list: if isPlatformStaff();
      allow write: if false;
    }

    // Fase 3.3: rastreamento/auditoria de execuções de provisionOrganization.
    // Mesma garantia estrutural de platformAdmins — só a Cloud Function
    // (Admin SDK) escreve, então todo o histórico é atestado pelo servidor.
    match /provisioningRuns/{runId} {
      allow read: if isPlatformStaff();
      allow write: if false;
    }

    match /organizations/{orgId} {
      // list (getDocs sem filtro) — só plataforma pode listar todas as orgs
      allow list: if isPlatformStaff();
      // get (documento específico) — plataforma ou mesma org
      allow get: if isPlatformStaff() || (isLoggedIn() && userOrgId() == orgId);
      // Fase 3.3: create fica só para o mecanismo oficial de provisionamento
      // (Cloud Function via Admin SDK, que ignora Rules) — nenhuma organização
      // deve nascer de um write direto do cliente daqui pra frente. update
      // continua permitido (é o que as abas Módulos/Assinatura/Configurações
      // do Painel Master usam pra editar uma organização que já existe).
      allow create: if false;
      allow update: if isPlatformAdministrator();
      // delete: nenhuma regra = negado por padrão — organização nunca é
      // apagada de verdade, só suspensa (ativo:false), mesmo padrão do
      // resto da plataforma. Confirmado: nenhuma tela chama deleteDoc aqui.
    }

    // Fase 3.5: projeção pública e curada de organizations/{orgId} — só os
    // campos seguros de branding (nome, logo, favicon, cores, módulos,
    // billingProvider), nunca observações internas/billingConfig/integrations
    // que o documento pai carrega desde a Fase 3.4. Precisa ser lida por
    // visitante anônimo (branding aparece antes de qualquer login) — o
    // documento pai continua exigindo login+mesma org (ver acima), então
    // esta é a única forma seed seguro de expor branding publicamente sem
    // reabrir o documento inteiro. Só a Cloud Function de sincronização
    // (trigger onWrite em organizations/{orgId}) escreve aqui.
    match /organizations/{orgId}/public/{docId} {
      allow get: if true;
      allow list: if false; // evita enumeração — leitura é sempre por ID conhecido
      allow write: if false;
    }

    // Fase 3.5: índice hostname → orgId, com unicidade garantida na Cloud
    // Function (setOrganizationDomains). Leitura pública — é só um roteador,
    // sem dado sensível (mesmo espírito de organizations/{orgId}/public/*
    // acima). Escrita só via Cloud Function (Admin SDK), pra garantir que a
    // checagem de unicidade entre organizações nunca seja contornável por um
    // write direto do cliente.
    match /domains/{hostname} {
      allow get: if true;
      allow list: if isPlatformStaff();
      allow write: if false;
    }

    // Fase 3.8 — Feature Flags. Leitura restrita a equipe de plataforma (nunca
    // ao cliente de uma organização): o documento agrega `overrides` de TODAS
    // as organizações — expor isso a um usuário comum vazaria dado
    // cross-tenant (ver comentário no topo de functions/lib/features.js).
    // Organizações resolvem sua própria flag via callable resolveFeatureFlags
    // (Admin SDK, ignora Rules, devolve só o booleano já resolvido). Escrita
    // sempre via Cloud Function (mesma garantia estrutural de platformAdmins).
    match /featureFlags/{flagKey} {
      allow read: if isPlatformStaff();
      allow write: if false;
    }

    match /systemPlans/{planId} {
      allow read: if isLoggedIn();
      allow write: if isPlatformAdministrator();
    }

    match /systemLogs/{logId} {
      allow read: if isPlatformStaff();
      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /organizationSubscriptions/{subId} {
      allow read: if isPlatformStaff();
      allow write: if isPlatformAdministrator();
    }

    match /systemConfig/{docId} {
      allow read: if isPlatformStaff();
      allow write: if isPlatformAdministrator();
    }

    // ===========================
    //   CMS — Conteúdo do Site
    // ===========================

    // Banners: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_banners/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Eventos: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_events/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Parceiros: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_partners/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Diretoria: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_board/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Galeria (álbuns): leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_gallery/{albumId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);

      // Fotos (subcoleção): não gravam orgId próprio — checa o álbum pai (G3)
      match /fotos/{fotoId} {
        allow read: if true;
        allow write: if canOperateOrgOfAlbum(albumId);
      }
    }

    // Sobre o Clube (singleton, docId == orgId): leitura pública, escrita
    // só admin/master da mesma org (G3) — usa o próprio docId, não precisa
    // ler resource.data (funciona até no create, quando resource ainda não existe).
    match /cms_about/{docId} {
      allow read: if true;
      allow write: if canOperateOrg(docId);
    }

    // ===========================
    //   Inscrições em Eventos
    // ===========================
    match /eventRegistrations/{regId} {
      // PATCH CRÍTICO (Fase 3.6): "read: if true" indistintamente permitia
      // list() público — getDocs(collection(db,'eventRegistrations')) sem
      // filtro nenhum despejava nome/CPF/telefone/token de TODAS as
      // inscrições de TODOS os eventos de TODAS as organizações. Split
      // get/list: get (1 doc por ID, usado por event_comprovante.html com o
      // regId da URL) continua público — é o mesmo modelo de "link com ID
      // não-adivinhável" que já era o desenho original; list (dump da
      // coleção) passa a exigir admin/master da própria org, igual ao que
      // admin_inscricoes.html já faz (query com where("orgId","==",...)).
      allow get: if true;
      allow list: if canOperateOrg(resource.data.orgId);
      // Criação pública (sem login) — validação de negócio feita via Cloud Function
      allow create: if request.resource.data.orgId is string
                    && request.resource.data.orgId.size() > 0;
      // Atualização por admin/master da mesma org (check-in, cancelamento) — G3
      allow update: if canOperateOrg(resource.data.orgId);
      allow delete: if false;
    }
  }
}
