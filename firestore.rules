// Firestore Security Rules (final, revisado)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helpers --------
    function isLoggedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // Lê o papel do usuário logado; se não existir doc, devolve string vazia
    function userRoleRaw() {
      return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
        : "";
    }

    // Lê o orgId do usuário logado
    function userOrgId() {
      return isLoggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    // Testes de papel (lower + trim para evitar problemas de capitalização/espaço)
    function roleLower() {
      return (userRoleRaw() is string) ? userRoleRaw().lower().trim() : "";
    }
    function isRole(roleName) { return roleLower() == roleName; }
    function isMaster()    { return isLoggedIn() && roleLower() == "master"; }
    function isAdminRole() { return isLoggedIn() && roleLower() == "admin"; }

    // Quem pode operar (admin OU master)
    function canOperate() { return isMaster() || isAdminRole(); }

    // >>> G3 (docs/SAAS_MULTITENANT.md): isolamento por organização.
    // canOperate() sozinho só checa PAPEL — um admin de qualquer org podia
    // ler/escrever dados de qualquer outra org. Estas três variantes
    // acrescentam a checagem de orgId; master continua cross-tenant por
    // definição (nunca comparado a nenhuma organização específica).
    function canOperateOrg(orgId) {
      return isMaster() || (isAdminRole() && userOrgId() == orgId);
    }

    // Para subcoleções de users/{userId} que não carregam orgId próprio
    // (finance/financeInvoices) — le o orgId do documento pai (o usuário
    // dono da subcoleção, não o admin logado).
    function canOperateOrgOfUser(userId) {
      return isMaster() || (
        isAdminRole() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.orgId == userOrgId()
      );
    }

    // Para cms_gallery/{albumId}/fotos/{fotoId} — os documentos de foto não
    // gravam orgId próprio, só o álbum pai grava.
    function canOperateOrgOfAlbum(albumId) {
      return isMaster() || (
        isAdminRole() &&
        exists(/databases/$(database)/documents/cms_gallery/$(albumId)) &&
        get(/databases/$(database)/documents/cms_gallery/$(albumId)).data.orgId == userOrgId()
      );
    }
    // <<< FIM G3

    // Associado ativo (pode criar lotes)
    function isAssociadoOrAdmin() {
      return isLoggedIn() && (
        isRole("associado") || isRole("admin") || isRole("master")
      );
    }

    // Impede que cliente comum altere campos sensíveis (aplicado em update de users)
    function noSensitiveFieldChange() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return !changed.hasAny([
        "role",
        "status",
        "inadimplenteLeilao",
        "ativo",
        "asaasId",
        "asaasSubscriptionId",
        "asaasSync",
        "orgId",
        "desativadoEm",
        "desativadoPor",
        "notaDesativacao",
        "categoriaAssociado",
        "responsavelCpf",
        "responsavelUid"
      ]);
    }

    // >>> ADIÇÃO: helpers para validação de criação de faturas pelo cliente
    function _hasOnlyKeys(allowedKeys) {
      // todos os campos novos precisam estar na lista de permitidos
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function _isInvoiceCreateValid() {
      // Permite criar SOMENTE estes campos
      let okKeys = _hasOnlyKeys([
        "planType",
        "planName",
        "planStart",
        "planEnd",
        "dueDate",
        "amount",
        "status",
        "months",
        "createdAt",
        "recordedAt"
      ]);

      // Tipos básicos
      let okTypes =
        (request.resource.data.amount is number) &&
        (request.resource.data.planType is string) &&
        (request.resource.data.planName is string);

      // Status inicial aceito
      let st = request.resource.data.status;
      let okStatus = (st is string) && (st.matches('(?i)^pendente$') || st.matches('(?i)^em_aberto$'));

      // Bloquear campos sensíveis na criação
      let noSensitive =
        !("paidAt" in request.resource.data) &&
        !("gatewayId" in request.resource.data) &&
        !("method" in request.resource.data) &&
        !("mp" in request.resource.data) &&
        !("updatedAt" in request.resource.data);

      return okKeys && okTypes && okStatus && noSensitive;
    }
    // <<< FIM ADIÇÃO

    // ===========================
    //   Catálogo: Serviços/Produtos
    // ===========================
    // Leitura exige sessão (isLoggedIn) — por isso dá para comparar orgId
    // aqui, diferente das coleções de CMS abaixo com leitura pública sem
    // sessão (ver docs/SAAS_MULTITENANT.md e a nota de reconciliação em
    // docs/architecture/README.md do Portal Associativo).
    match /memberServices/{docId} {
      allow read:   if isMaster() || (isLoggedIn() && resource.data.orgId == userOrgId());
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    match /memberProducts/{docId} {
      allow read:   if isMaster() || (isLoggedIn() && resource.data.orgId == userOrgId());
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // ===========================
    //   Legacy/Área do Associado: classificados internos
    // ===========================
    match /memberClassifieds/{docId} {
      // leitura pública (ajuste se quiser privatizar)
      allow read: if true;

      // CREATE: logado e dono informado por qualquer um dos campos aceitos
      allow create: if isLoggedIn() &&
                    (
                      ("createdBy" in request.resource.data && request.resource.data.createdBy == request.auth.uid)
                      ||
                      ("ownerUid"  in request.resource.data && request.resource.data.ownerUid  == request.auth.uid)
                    );

      // UPDATE:
      // - admin/master/superUID: tudo
      // - dono: pode atualizar, mas NÃO pode mudar campos de propriedade/approvação
      allow update: if
        canOperate()
        ||
        (
          isLoggedIn() &&
          (
            resource.data.createdBy == request.auth.uid ||
            ("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid)
          ) &&
          !(
            "approved"  in request.resource.data.diff(resource.data).changedKeys() ||
            "createdBy" in request.resource.data.diff(resource.data).changedKeys() ||
            "ownerUid"  in request.resource.data.diff(resource.data).changedKeys()
          )
        );

      // DELETE: admin/master/superUID ou dono
      allow delete: if
        canOperate()
        ||
        (
          isLoggedIn() &&
          (
            resource.data.createdBy == request.auth.uid ||
            ("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid)
          )
        );
    }

    // ===========================
    //   Coleção pública 'classificados'
    // ===========================
    match /classificados/{docId} {
      // leitura pública (qualquer visitante)
      allow get, list: if true;

      // CREATE: logado + createdBy==uid OU ownerUid==uid
      allow create: if isLoggedIn() &&
                    (
                      ("ownerUid"  in request.resource.data && request.resource.data.ownerUid  == request.auth.uid)
                      ||
                      ("createdBy" in request.resource.data && request.resource.data.createdBy == request.auth.uid)
                    );

      // UPDATE:
      // - admin/master/superUID: tudo
      // - dono: não pode mudar ownerUid/ownerEmail/createdBy
      allow update: if
        canOperate()
        ||
        (
          isLoggedIn() &&
          (
            ("ownerUid"  in resource.data && resource.data.ownerUid  == request.auth.uid) ||
            ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid)
          ) &&
          !(
            "ownerUid"   in request.resource.data.diff(resource.data).changedKeys() ||
            "ownerEmail" in request.resource.data.diff(resource.data).changedKeys() ||
            "createdBy"  in request.resource.data.diff(resource.data).changedKeys()
          )
        );

      // DELETE: admin/master/superUID ou dono
      allow delete: if
        canOperate()
        ||
        (
          isLoggedIn() &&
          (
            ("ownerUid"  in resource.data && resource.data.ownerUid  == request.auth.uid) ||
            ("createdBy" in resource.data && resource.data.createdBy == request.auth.uid)
          )
        );
    }

    // ===========================
    //   Usuários + Financeiro
    // ===========================
    match /users/{userId} {

      // Leitura de 1 doc:
      // - dono lê o próprio
      // - master lê qualquer um; admin só da própria org (G3)
      allow get: if isSelf(userId) || isMaster() || (isAdminRole() && resource.data.orgId == userOrgId());

      // Listagem (para grids/admin) — master lista todas; admin só filtra
      // (Firestore avalia "list" por documento candidato quando a regra usa
      // resource.data — docs de outra org simplesmente não retornam, sem
      // depender de nenhum where() do lado do cliente).
      allow list: if isMaster() || (isAdminRole() && resource.data.orgId == userOrgId());

      // Criação:
      // - dono cria o próprio (signup)
      // - master cria qualquer perfil; admin só na própria org (G3)
      allow create: if isSelf(userId) || isMaster() || (isAdminRole() && request.resource.data.orgId == userOrgId());

      // Atualização:
      // - dono: tudo exceto campos sensíveis (já bloqueia troca de orgId)
      // - master: qualquer campo, qualquer org
      // - admin: só da própria org, e nunca pode mudar o orgId do documento
      //   (gap encontrado durante G3: canOperate() sozinho permitia trocar
      //   orgId no mesmo update que qualquer outro campo)
      allow update: if
        (isSelf(userId) && noSensitiveFieldChange())
        || isMaster()
        || (
          isAdminRole()
          && resource.data.orgId == userOrgId()
          && !("orgId" in request.resource.data.diff(resource.data).changedKeys())
        );

      // -------- FINANCE (doc 'summary' e outros docs soltos) --------
      match /finance/{docId} {
        // dono, master e admin-da-mesma-org podem LER (summary, etc.) — G3
        allow read:  if isSelf(userId) || canOperateOrgOfUser(userId);
        // master e admin-da-mesma-org podem ESCREVER (summary, etc.) — G3
        allow write: if canOperateOrgOfUser(userId);

        // (Mantido por compatibilidade com estrutura antiga)
        match /invoices/{invId} {
          allow read:  if isSelf(userId) || canOperateOrgOfUser(userId);
          allow write: if canOperateOrgOfUser(userId);
        }
      }

      // -------- NOVA COLEÇÃO DE FATURAS --------
      // Subcoleção direta para faturas: users/{uid}/financeInvoices/{invoiceId}
      match /financeInvoices/{invId} {
        // dono, master e admin-da-mesma-org podem LER — G3
        allow read:  if isSelf(userId) || canOperateOrgOfUser(userId);

        // >>> ADIÇÃO: permitir o PRÓPRIO USUÁRIO criar a PRÓPRIA fatura
        allow create: if isSelf(userId) && _isInvoiceCreateValid();

        // master e admin-da-mesma-org continuam podendo escrever
        // (editar/cancelar/pagar) — G3
        allow write: if canOperateOrgOfUser(userId);
      }
    }

    // ===========================
    //   Módulo de Leilões
    // ===========================

    match /auctionLots/{lotId} {
      // Leitura pública para lotes publicados/encerrados/concluídos
      allow get:  if resource.data.status in ["publicado","encerrado","pago","concluido","cancelado"]
                  || (isLoggedIn() && (
                       request.auth.uid == resource.data.sellerUid
                       || canOperate()
                     ));
      allow list: if
        canOperate()
        || isAssociadoOrAdmin(); // associados podem listar; participanteLeilao usa apenas get

      // Criação: apenas associados (não participanteLeilao)
      allow create: if isAssociadoOrAdmin()
                    && request.resource.data.sellerUid == request.auth.uid
                    && request.resource.data.status in ["rascunho","em_analise"];

      // Atualização pelo dono (apenas em rascunho ou rejeitado; não pode alterar campos de aprovação)
      allow update: if
        canOperate()
        || (
          isLoggedIn()
          && request.auth.uid == resource.data.sellerUid
          && resource.data.status in ["rascunho","rejeitado"]
          && !(request.resource.data.diff(resource.data).changedKeys().hasAny(
               ["approvedBy","approvedAt","lastBid","lastBidderUid","bidCount"]))
        )
        || (
          // Envio para análise: dono pode mudar status rascunho → em_analise
          isLoggedIn()
          && request.auth.uid == resource.data.sellerUid
          && resource.data.status == "rascunho"
          && request.resource.data.status == "em_analise"
          && !(request.resource.data.diff(resource.data).changedKeys().hasAny(
               ["approvedBy","approvedAt","lastBid","lastBidderUid","bidCount"]))
        )
        || (
          // Cancelamento: dono pode cancelar lote em rascunho
          isLoggedIn()
          && request.auth.uid == resource.data.sellerUid
          && resource.data.status == "rascunho"
          && request.resource.data.status == "cancelado"
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status","updatedAt"])
        );
    }

    match /auctionLots/{lotId}/bids/{bidId} {
      // Lances: leitura para qualquer usuário autenticado
      allow read: if isLoggedIn();
      // Escrita: SOMENTE via Cloud Function (Admin SDK ignora essas regras)
      allow write: if false;
    }

    match /auctionSales/{saleId} {
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.sellerUid
        || request.auth.uid == resource.data.buyerUid
        || canOperate()
      );
      allow write: if false; // Apenas Cloud Functions
    }

    match /auctionPayments/{paymentId} {
      allow read: if isLoggedIn() && (
        request.auth.uid == resource.data.buyerUid
        || canOperate()
      );
      allow write: if false; // Apenas Cloud Functions
    }

    match /auctionNotifications/{notifId} {
      allow read: if isLoggedIn() && request.auth.uid == resource.data.recipientUid;
      // Permite marcar notificação como lida
      allow update: if isLoggedIn()
                    && request.auth.uid == resource.data.recipientUid
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"]);
      allow create, delete: if false; // Apenas Cloud Functions
    }

    // ===========================
    //   Multi-Tenant: Organizations & System
    // ===========================

    match /organizations/{orgId} {
      // list (getDocs sem filtro) — só master pode listar todas as orgs
      allow list: if isMaster();
      // get (documento específico) — master ou mesmo org
      allow get: if isMaster() || (isLoggedIn() && userOrgId() == orgId);
      allow write: if isMaster();
    }

    match /systemPlans/{planId} {
      allow read: if isLoggedIn();
      allow write: if isMaster();
    }

    match /systemLogs/{logId} {
      allow read: if isMaster();
      allow create: if isLoggedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /organizationSubscriptions/{subId} {
      allow read, write: if isMaster();
    }

    match /systemConfig/{docId} {
      allow read, write: if isMaster();
    }

    // ===========================
    //   CMS — Conteúdo do Site
    // ===========================

    // Banners: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_banners/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Eventos: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_events/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Parceiros: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_partners/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Diretoria: leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_board/{docId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);
    }

    // Galeria (álbuns): leitura pública, escrita só admin/master da mesma org (G3)
    match /cms_gallery/{albumId} {
      allow read: if true;
      allow create: if canOperateOrg(request.resource.data.orgId);
      allow update, delete: if canOperateOrg(resource.data.orgId);

      // Fotos (subcoleção): não gravam orgId próprio — checa o álbum pai (G3)
      match /fotos/{fotoId} {
        allow read: if true;
        allow write: if canOperateOrgOfAlbum(albumId);
      }
    }

    // Sobre o Clube (singleton, docId == orgId): leitura pública, escrita
    // só admin/master da mesma org (G3) — usa o próprio docId, não precisa
    // ler resource.data (funciona até no create, quando resource ainda não existe).
    match /cms_about/{docId} {
      allow read: if true;
      allow write: if canOperateOrg(docId);
    }

    // ===========================
    //   Inscrições em Eventos
    // ===========================
    match /eventRegistrations/{regId} {
      // Leitura pública — viewToken valida acesso ao comprovante no client
      allow read: if true;
      // Criação pública (sem login) — validação de negócio feita via Cloud Function
      allow create: if request.resource.data.orgId is string
                    && request.resource.data.orgId.size() > 0;
      // Atualização por admin/master da mesma org (check-in, cancelamento) — G3
      allow update: if canOperateOrg(resource.data.orgId);
      allow delete: if false;
    }
  }
}
